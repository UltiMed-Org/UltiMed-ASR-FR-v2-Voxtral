@@ -382,6 +387,74 @@ class VoxtralTTSForConditionalGeneration(
         state = ((state ^ (state >> 27)) * 0x94D049BB133111EB) & cls._MASK64
         return state ^ (state >> 31)
 
+    def _dump_frame_codes(self, multimodal_outputs: dict | None, sampling_extra_args: list[dict] | None) -> None:
+        """Append this decode step's audio codes to a per-request file, on request.
+
+        Local fork, and a data-collection tool rather than a serving feature. The
+        open checkpoint ships no audio encoder, so the only source of real
+        audio <-> codes pairs is this model generating them: stage 0 IS the map
+        from text to on-manifold codes, and the codes it emits here are the same
+        table-space ids (offset by the two special tokens) that a voice prefix
+        carries, so a dump needs no conversion to be usable as a voice.
+
+        Nothing is written unless a request sets ``voxtral_dump_codes`` in its
+        ``extra_params`` to a tag, and the env var ``VOXTRAL_CODE_DUMP_DIR``
+        points somewhere writable. The tag rides the same per-row
+        ``sampling_extra_args`` route as the noise seed, so it is per request and
+        stays correct under concurrency: rows are matched to tags by batch
+        position, exactly as ``_make_frame_noise`` matches them to seeds.
+
+        Frames are appended as raw little-endian int16, one row of
+        ``1 + n_acoustic_codebook`` values per decode step, because appending is
+        the only format that survives a request being cut off, preempted or
+        cancelled mid-utterance. The reader reshapes to ``(-1, n_codebooks)``.
+
+        Parameters
+        ----------
+        multimodal_outputs : dict | None
+            ``{"audio": [ (1, 1, C) tensor per row ]}`` as built by
+            ``compute_mm_logits``, in batch order.
+        sampling_extra_args : list[dict] | None
+            Per-request extra_args dicts in batch order, or None when stage 0's
+            default extra_args are empty (which switches off per-request extras
+            altogether, cfg_alpha included).
+        """
+        if not sampling_extra_args or not multimodal_outputs:
+            return
+        tags = [row.get(self._DUMP_CODES_KEY) if isinstance(row, dict) else None for row in sampling_extra_args]
+        if all(tag is None for tag in tags):
+            return
+
+        directory = os.environ.get("VOXTRAL_CODE_DUMP_DIR")
+        if not directory:
+            if not type(self)._dump_warned:
+                type(self)._dump_warned = True
+                logger.warning(
+                    "%s was requested but VOXTRAL_CODE_DUMP_DIR is unset, so no codes are being written",
+                    self._DUMP_CODES_KEY,
+                )
+            return
+
+        audio = multimodal_outputs.get("audio")
+        if audio is None:
+            return
+        for index, tag in enumerate(tags):
+            if tag is None or index >= len(audio):
+                continue
+            # Only characters that cannot escape the dump directory survive, so a
+            # tag can never name a file outside it.
+            safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(tag))[:128]
+            if not safe or safe.strip(".") == "":
+                continue
+            codes = audio[index].reshape(-1).to(torch.int16).cpu().numpy()
+            try:
+                with open(os.path.join(directory, safe + ".i16"), "ab") as handle:
+                    handle.write(codes.tobytes())
+            except OSError as error:
+                if not type(self)._dump_warned:
+                    type(self)._dump_warned = True
+                    logger.warning("could not write %s codes to %s: %s", self._DUMP_CODES_KEY, directory, error)
+
     def _make_frame_noise(
         self, input_hidden_states: torch.Tensor, sampling_extra_args: list[dict] | None
     ) -> torch.Tensor | None:
@@ -553,6 +626,9 @@ class VoxtralTTSForConditionalGeneration(
                         input_hidden_states, cfg_alpha=cfg_alpha, noise=noise, n_steps=n_steps
