+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""
+Tests for the per-request stage-0 code dump (local fork).
+
+These cover ``VoxtralTTSForConditionalGeneration._dump_frame_codes``, which
+appends the codes stage 0 emits to a file when a request carries
+``voxtral_dump_codes`` in its ``extra_params``. It exists because the open
+checkpoint ships no audio encoder, so the model generating its own codes is the
+only source of real audio/codes pairs to train one on.
+
+The properties worth pinning down:
+
+* a batch that asked for nothing must write nothing, and must not need the env
+  var to be set at all (this runs on every decode step of every request);
+* rows must be matched to tags by batch position, so one request's codes never
+  land in another's file, which is the same property the noise seed needs;
+* frames must accumulate in emission order across steps, since an utterance is
+  built one 12.5 Hz frame per step;
+* a tag must not be able to name a file outside the dump directory.
+"""
+
+import functools
+
+import numpy as np
+import pytest
+import torch
+
+pytestmark = [pytest.mark.core_model, pytest.mark.cpu]
+
+N_CODEBOOKS = 37
+
+
+@functools.lru_cache(maxsize=1)
+def _voxtral_tts_class():
+    # Same import dance as the other voxtral_tts tests: pin vLLM's layer
+    # custom-op modules first so ``direct_register_custom_op`` does not run twice.
+    from tests.model_executor.helpers import bootstrap_vllm_layer_custom_op_modules
+
+    bootstrap_vllm_layer_custom_op_modules()
+    import vllm.model_executor.models.utils  # noqa: F401
+
+    from vllm_omni.model_executor.models.voxtral_tts.voxtral_tts import (
+        VoxtralTTSForConditionalGeneration,
+    )
+
+    return VoxtralTTSForConditionalGeneration
+
+
+def _make_model():
+    """Build an instance without running the real ``__init__``.
+
+    The method under test reads only class-level key names, so nothing from the
+    ~9GB checkpoint or a VllmConfig is needed.
+    """
+    cls = _voxtral_tts_class()
+    model = cls.__new__(cls)
+    torch.nn.Module.__init__(model)
+    return model
+
+
+def _outputs(rows: list[list[int]]) -> dict:
+    """Shape one decode step's codes the way ``compute_mm_logits`` does."""
+    return {"audio": [torch.tensor(row, dtype=torch.int32).reshape(1, 1, -1) for row in rows]}
+
+
+def _read(directory, tag: str) -> np.ndarray:
+    return np.fromfile(directory / f"{tag}.i16", dtype="<i2").reshape(-1, N_CODEBOOKS)
+
+
+def test_nothing_asked_for_writes_nothing(tmp_path, monkeypatch):
+    monkeypatch.setenv("VOXTRAL_CODE_DUMP_DIR", str(tmp_path))
+    model = _make_model()
+    model._dump_frame_codes(_outputs([list(range(N_CODEBOOKS))]), None)
+    model._dump_frame_codes(_outputs([list(range(N_CODEBOOKS))]), [])
+    model._dump_frame_codes(_outputs([list(range(N_CODEBOOKS))]), [{"cfg_alpha": 1.3}])
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_missing_env_var_is_not_fatal(tmp_path, monkeypatch):
+    # A request can ask for a dump on a server that was never configured for one;
+    # that must cost a warning, not an exception on every frame.
+    monkeypatch.delenv("VOXTRAL_CODE_DUMP_DIR", raising=False)
+    model = _make_model()
+    model._dump_frame_codes(_outputs([list(range(N_CODEBOOKS))]), [{"voxtral_dump_codes": "x"}])
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_frames_accumulate_in_order(tmp_path, monkeypatch):
+    monkeypatch.setenv("VOXTRAL_CODE_DUMP_DIR", str(tmp_path))
+    model = _make_model()
+    for frame in range(5):
+        model._dump_frame_codes(
+            _outputs([[frame] * N_CODEBOOKS]),
+            [{"voxtral_dump_codes": "utterance"}],
+        )
+    written = _read(tmp_path, "utterance")
+    assert written.shape == (5, N_CODEBOOKS)
+    assert written[:, 0].tolist() == [0, 1, 2, 3, 4]
+
+
+def test_rows_go_to_their_own_tag(tmp_path, monkeypatch):
+    # The property that makes this safe under concurrency: a batch mixes requests,
+    # and each row's codes must follow its own tag rather than its neighbour's.
+    monkeypatch.setenv("VOXTRAL_CODE_DUMP_DIR", str(tmp_path))
+    model = _make_model()
+    for frame in range(3):
+        model._dump_frame_codes(
+            _outputs([[10 + frame] * N_CODEBOOKS, [20 + frame] * N_CODEBOOKS, [30 + frame] * N_CODEBOOKS]),
+            [{"voxtral_dump_codes": "left"}, {"cfg_alpha": 1.2}, {"voxtral_dump_codes": "right"}],
+        )
+    assert _read(tmp_path, "left")[:, 0].tolist() == [10, 11, 12]
+    assert _read(tmp_path, "right")[:, 0].tolist() == [30, 31, 32]
+    assert sorted(path.name for path in tmp_path.iterdir()) == ["left.i16", "right.i16"]
+
+
+def test_tag_cannot_escape_the_dump_directory(tmp_path, monkeypatch):
+    monkeypatch.setenv("VOXTRAL_CODE_DUMP_DIR", str(tmp_path / "dumps"))
+    (tmp_path / "dumps").mkdir()
+    model = _make_model()
+    model._dump_frame_codes(
+        _outputs([list(range(N_CODEBOOKS))]),
+        [{"voxtral_dump_codes": "../escaped"}],
+    )
+    assert not (tmp_path / "escaped.i16").exists()
+    assert [path.name for path in (tmp_path / "dumps").iterdir()] == [".._escaped.i16"]
+
+
+@pytest.mark.parametrize("tag", ["", ".", ".."])
+def test_degenerate_tags_write_nothing(tmp_path, monkeypatch, tag):
+    # A tag that sanitises down to nothing, or to a directory entry that is not a
+    # name, is dropped rather than turned into some arbitrary file.
+    monkeypatch.setenv("VOXTRAL_CODE_DUMP_DIR", str(tmp_path))
+    model = _make_model()
+    model._dump_frame_codes(_outputs([list(range(N_CODEBOOKS))]), [{"voxtral_dump_codes": tag}])
+    assert list(tmp_path.iterdir()) == []
