COMPOSE_PROJECT_NAME=crispasr

# Which whisper ggml the ASR service loads (interpolated into CRISPASR_EXTRA_ARGS in
# docker-compose.yml; unset = ggml-large-v3-turbo.bin). Uncomment to flip the judge to
# non-turbo large-v3 for a second-opinion QC pass, and drop the replicas to 4 while it
# is on: ~3.1GB per replica against turbo's ~1.6GB on a 24GB card that drives a display.
# Here rather than in the shell because this sudoers refuses `sudo -E docker compose`.
#CRISPASR_ASR_GGML=ggml-large-v3.bin
