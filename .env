CRISPASR_IMAGE=ghcr.io/crispstrobe/crispasr:main
CRISPASR_IMAGE_CUDA=ghcr.io/crispstrobe/crispasr:main-cuda
CRISPASR_PORT=8002
# CRISPASR_MODEL=/models/parakeet.gguf
# CRISPASR_BACKEND=parakeet
CRISPASR_BACKEND=voxtral
CRISPASR_LANGUAGE=auto
CRISPASR_AUTO_DOWNLOAD=1
CRISPASR_API_KEYS=CHANGE_ME_set_your_own_key
CRISPASR_EXTRA_ARGS="--verbose"
CRISPASR_DIAGNOSTICS=0
